{
  "51710": {
    "name": "Norfolk",
    "source": "City of Norfolk open GIS data (gisshare.norfolk.gov, OpenData/Environmental_Group_OpenData)",
    "pipes": [
      {
        "url": "https://gisshare.norfolk.gov/pubserver/rest/services/OpenData/Environmental_Group_OpenData/MapServer/8",
        "fields": "PIPE_ID,PIPE_SIZE,OWNER"
      }
    ],
    "ditches": [
      {
        "url": "https://gisshare.norfolk.gov/pubserver/rest/services/OpenData/Environmental_Group_OpenData/MapServer/7",
        "fields": "DITCH_TYPE"
      }
    ],
    "structures": [
      {
        "url": "https://gisshare.norfolk.gov/pubserver/rest/services/OpenData/Environmental_Group_OpenData/MapServer/9",
        "fields": "GENERAL_TYPE,STRUCTURE_TYPE,ACCESSORY,OUTFALL,RIM_ELEVATION_FT"
      }
    ],
    "structure_type_field": "GENERAL_TYPE",
    "closed_types": [
      "manhole",
      "junction box",
      "pipe connection",
      "abandoned",
      "plugged",
      "stub",
      "roof drain",
      "pipe to building",
      "underground control",
      "utility conflict",
      "unknown"
    ],
    "valve_field": "ACCESSORY",
    "valve_words": [
      "fv",
      "flap",
      "gate",
      "check"
    ]
  },
  "51700": {
    "name": "Newport News",
    "source": "City of Newport News GIS (maps.nnva.gov, Operational/Stormwater*)",
    "pipes": [
      {
        "url": "https://maps.nnva.gov/gis/rest/services/Operational/StormwaterGravityMain/MapServer/0",
        "fields": "FACILITYID,DIAMETER,PIPETYPE"
      }
    ],
    "ditches": [
      {
        "url": "https://maps.nnva.gov/gis/rest/services/Operational/StormwaterDitch/MapServer/0",
        "fields": "FACILITYID"
      }
    ],
    "structures": [
      {
        "url": "https://maps.nnva.gov/gis/rest/services/Operational/StormwaterInlet/MapServer/0",
        "fields": "FACILITYID,INLETTYPE,RIMELEVATION",
        "name": "inlet"
      },
      {
        "url": "https://maps.nnva.gov/gis/rest/services/Operational/StormwaterEndSection/MapServer/0",
        "fields": "FACILITYID,ESTYPE,TIDEGATE",
        "name": "end section"
      },
      {
        "url": "https://maps.nnva.gov/gis/rest/services/Operational/StormwaterManhole/MapServer/0",
        "fields": "FACILITYID,MANHOLETYPE",
        "name": "manhole",
        "closed": true
      }
    ],
    "valve_field": "TIDEGATE",
    "valve_words": [
      "1"
    ],
    "snap_m": 1.0,
    "snap_note": "the pipes stop about 0.85 m short of the structure points (60% of pipe ends), so ends and structures within 1 m are joined"
  },
  "51810": {
    "name": "Virginia Beach",
