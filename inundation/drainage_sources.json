        "where": "LineType IN ('Rd Pipe','Ellip Pipe','BC','1/2 PI','Trench/Grate','Trench')"
      }
    ],
    "ditches": [
      {
        "url": "https://services5.arcgis.com/cA4ofagPaJJ7qhEz/arcgis/rest/services/Drainage_Capacity/FeatureServer/0",
        "fields": "LineNumber,LineType",
        "where": "LineType IN ('Ditch','PD','Swale')"
      }
    ],
    "structures": [],
    "pipe_ends_open": true,
    "pipe_ends_note": "the city publishes the lines only, so every pipe end is taken as an inlet or outlet"
  },
