  "51550": {
    "name": "Chesapeake",
    "source": "City of Chesapeake Public Works (ArcGIS Online, Stormwater_Lines; no structure layer is published)",
    "pipes": [
      {
        "url": "https://services1.arcgis.com/OAphVRUvJVpBRovs/arcgis/rest/services/Stormwater_Lines/FeatureServer/0",
        "fields": "ASSETID,LDETTYPE",
        "where": "LDETTYPE IN ('PSW','PPV','CVT')"
      }
    ],
    "ditches": [
      {
        "url": "https://services1.arcgis.com/OAphVRUvJVpBRovs/arcgis/rest/services/Stormwater_Lines/FeatureServer/0",
        "fields": "ASSETID,LDETTYPE",
        "where": "LDETTYPE IN ('DRS','DPV','DNR','SWL','NWW','OLF','OTH')"
      }
    ],
    "structures": [],
    "pipe_ends_open": true,
    "pipe_ends_note": "the city publishes the lines only, so every pipe end is taken as an inlet or outlet"
  },
  "51650": {
