      {
        "url": "https://gisweb.pwcva.gov/arcgis/rest/services/PublicWorks/Stormwater_Inventory/MapServer/3",
        "fields": "SegmentType,InflowStructureType,OutflowStructureType",
        "where": "SegmentType IS NULL OR NOT (SegmentType LIKE '%RR' OR SegmentType LIKE '%GD' OR SegmentType LIKE '%CD' OR SegmentType LIKE '%NS' OR SegmentType LIKE '%TD')"
      }
    ],
    "ditches": [
      {
        "url": "https://gisweb.pwcva.gov/arcgis/rest/services/PublicWorks/Stormwater_Inventory/MapServer/3",
        "fields": "SegmentType",
        "where": "SegmentType LIKE '%RR' OR SegmentType LIKE '%GD' OR SegmentType LIKE '%CD' OR SegmentType LIKE '%NS' OR SegmentType LIKE '%TD'"
      }
    ],
    "end_type_fields": [
      "InflowStructureType",
      "OutflowStructureType"
    ],
    "end_none_types": [
      "ns"
    ],
    "closed_types": [
      "mh",
      "tee",
      "jb",
      "co",
      "unk"
    ],
    "closed_note": "manholes (MH), tees, junction boxes (JB) and cleanouts (CO) are closed; NS (no structure) leaves a pipe end as a free end"
  },
